---
import { getCollection } from 'astro:content';
import DigestPreviewCard from '../../components/DigestPreviewCard.astro';
import Logo from '../../components/Logo.astro';
import PreferenceControls from '../../components/PreferenceControls.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Layout from '../../layouts/Layout.astro';
import { groupEntriesByDate } from '../../lib/digestGrouping.js';
import { isFlagEnabled } from '../../lib/featureFlags.js';

const devModeEnabled = isFlagEnabled(import.meta.env.ENABLE_DEV_MODE);
const allEntries = await getCollection('digest');
const dateGroups = groupEntriesByDate(allEntries);

// CollectionPage wrapping an ItemList of the real dated sub-pages - a
// different shape than DigestList.astro's own ItemList (which points at
// external story URLs); this one points at this site's own internal
// /archive/{date}/ pages, since this page lists DATES, not story items.
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All digests',
  url: new URL('/archive/', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: dateGroups.map((group, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/archive/${group.date}/`, Astro.site).href,
      name: group.date,
    })),
  },
};

// Real 2-level trail (Home > All digests) - the final/current-page
// ListItem omits `item` per Google's own documented convention.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'The Daily Dose', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'All digests' },
  ],
};
---

<Layout
  title="The Daily Dose — all digests"
  description="Every past daily-dose digest, browsable by date — AI-curated and scored Hacker News, arXiv, GitHub, and Dev.to picks, archived day by day since launch."
  path="/archive/"
>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <header class="masthead">
    <div class="masthead-utility">
      <nav class="site-nav">
        <a href="/">&larr; Back to digest</a>
      </nav>
      <PreferenceControls devModeEnabled={devModeEnabled} />
    </div>
    <hgroup class="masthead-brand">
      <h1><Logo /> All digests</h1>
      <p class="tagline">Every past day's digest, most recent first.</p>
    </hgroup>
  </header>

  <main>
    {dateGroups.length > 0 ? (
      <ul class="date-list">
        {dateGroups.map((group) => (
          <DigestPreviewCard group={group} />
        ))}
      </ul>
    ) : (
      <p class="empty-state">
        No digest data yet. Run <code>npm run pipeline</code> to fetch the latest Hacker News,
        arXiv, and GitHub content and generate the first digest.
      </p>
    )}
  </main>

  <SiteFooter />
</Layout>

<style>
  .date-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>
