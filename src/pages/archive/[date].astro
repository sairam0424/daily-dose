---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import DigestList from '../../components/DigestList.astro';
import FilterBar from '../../components/FilterBar.astro';
import Logo from '../../components/Logo.astro';
import PreferenceControls from '../../components/PreferenceControls.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Layout from '../../layouts/Layout.astro';
import { groupEntriesByDate } from '../../lib/digestGrouping.js';
import { isFlagEnabled } from '../../lib/featureFlags.js';
import { safeJsonLdString } from '../../lib/jsonLd.js';
import { quoteLeadTitle } from '../../lib/leadTitle.js';

interface DateParams {
  date: string;
}

interface DateProps {
  entries: CollectionEntry<'digest'>[];
  olderDate: string | null;
  newerDate: string | null;
}

export async function getStaticPaths() {
  const allEntries = await getCollection('digest');
  const dateGroups = groupEntriesByDate(allEntries);

  return dateGroups.map((group, index) => ({
    params: { date: group.date },
    props: {
      entries: group.entries,
      // dateGroups is sorted most-recent-first, so the next index is the
      // chronologically older date and the previous index is newer.
      olderDate: dateGroups[index + 1]?.date ?? null,
      newerDate: index > 0 ? dateGroups[index - 1].date : null,
    },
  }));
}

const { date } = Astro.params as unknown as DateParams;
const { entries, olderDate, newerDate } = Astro.props as DateProps;
const devModeEnabled = isFlagEnabled(import.meta.env.ENABLE_DEV_MODE);

// entries is already sorted score-descending within this date (see
// groupEntriesByDate's documented contract) - entries[0] is genuinely
// this date's top-scored real item, not an arbitrary pick. getStaticPaths
// only generates a page for dates with at least one real committed entry,
// so entries[0] always exists here.
const leadEntry = entries[0];
const storyCountLabel = `${entries.length} ${entries.length === 1 ? "story" : "stories"}`;

// quoteLeadTitle (real per-date title quoting/truncation, unbounded free
// text from HN/arXiv/GitHub/Dev.to) lives in ../../lib/leadTitle.js so it
// stays directly Vitest-testable - see that file for the full rationale.
const leadTitleQuoted = quoteLeadTitle(leadEntry.data.title);

// Real 3-level trail (Home > All digests > {date}) - the final/
// current-page ListItem omits `item` per Google's own documented
// convention.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'The Daily Dose', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'All digests', item: new URL('/archive/', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: date },
  ],
};
---

<Layout
  title={`The Daily Dose — ${date}`}
  description={`The daily-dose digest for ${date} — ${storyCountLabel} from Hacker News, arXiv, GitHub, and Dev.to, led by ${leadTitleQuoted}`}
  path={`/archive/${date}/`}
>
  <script type="application/ld+json" set:html={safeJsonLdString(breadcrumbSchema)} />
  <header class="masthead">
    <div class="masthead-utility">
      <nav class="site-nav">
        <a href="/">&larr; Latest digest</a>
        <a href="/archive/">All digests</a>
      </nav>
      <PreferenceControls devModeEnabled={devModeEnabled} />
    </div>
    <hgroup class="masthead-brand">
      <h1><Logo /> Digest — {date}</h1>
      <p class="tagline">{storyCountLabel}, led by {leadTitleQuoted}</p>
    </hgroup>
  </header>

  <main>
    <h2 class="section-heading">Digest — {date}</h2>
    <FilterBar />
    <DigestList entries={entries} />

    <nav class="date-nav">
      <span>
        {olderDate ? <a href={`/archive/${olderDate}/`}>&larr; Older ({olderDate})</a> : null}
      </span>
      <span>
        {newerDate ? <a href={`/archive/${newerDate}/`}>Newer ({newerDate}) &rarr;</a> : null}
      </span>
    </nav>
  </main>

  <SiteFooter />
</Layout>

<style>
  .date-nav {
    margin-top: 2rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.9rem;
    font-family: var(--font-body);
  }

  .date-nav a {
    color: var(--accent);
    text-decoration: none;
  }

  .date-nav a:hover {
    text-decoration: underline;
  }

  .date-nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
