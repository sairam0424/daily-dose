---
import { getCollection } from 'astro:content';
import DigestList from '../components/DigestList.astro';
import FilterBar from '../components/FilterBar.astro';
import Logo from '../components/Logo.astro';
import PreferenceControls from '../components/PreferenceControls.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Layout from '../layouts/Layout.astro';
import { groupEntriesByDate } from '../lib/digestGrouping.js';
import { isFlagEnabled } from '../lib/featureFlags.js';

const devModeEnabled = isFlagEnabled(import.meta.env.ENABLE_DEV_MODE);
const allEntries = await getCollection('digest');
const dateGroups = groupEntriesByDate(allEntries);

const latestGroup = dateGroups.length > 0 ? dateGroups[0] : null;
const latestDate = latestGroup?.date ?? null;
const latestEntries = latestGroup?.entries ?? [];
// dateGroups is sorted most-recent-first (see digestGrouping.js), so index
// 1 is the next OLDER real digest date - the homepage is always the
// newest edition, so there is never a "newer" direction to offer here
// (matching tdd.cat's own masthead: its "Next edition" button is
// disabled while viewing the latest edition).
const olderDate = dateGroups[1]?.date ?? null;
---

<Layout
  title="daily-dose"
  description="The technical news worth your next fifteen minutes — Hacker News, arXiv, GitHub, and Dev.to, AI-curated daily."
  path="/"
>
  <header class="masthead">
    <div class="masthead-utility">
      <nav class="site-nav">
        <a href="/archive/">All digests &rarr;</a>
      </nav>
      <span class="date-nav">
        {olderDate ? (
          <a href={`/archive/${olderDate}/`}>&larr; Older ({olderDate})</a>
        ) : (
          <span class="date-nav-disabled" aria-disabled="true">&larr; Older</span>
        )}
      </span>
      {latestEntries.length > 0 && (
        <span class="story-count">
          {latestEntries.length} {latestEntries.length === 1 ? 'story' : 'stories'}
        </span>
      )}
      <PreferenceControls devModeEnabled={devModeEnabled} />
    </div>
    <hgroup class="masthead-brand">
      <h1><Logo /> The Daily Dose</h1>
      <p class="tagline">The technical news worth your next fifteen minutes.</p>
    </hgroup>
  </header>

  <main>
    {latestDate ? (
      <>
        <h2 class="section-heading">Latest digest — {latestDate}</h2>
        <FilterBar />
        <DigestList entries={latestEntries} />
      </>
    ) : (
      <p class="empty-state">
        No digest data yet. Run <code>npm run pipeline</code> to fetch the latest Hacker News,
        arXiv, GitHub, and Dev.to content and generate today's digest.
      </p>
    )}
  </main>

  <SiteFooter />
</Layout>

<style>
  /* Four real zones (nav link / date-nav / story count / theme toggle)
     instead of one centered cluster - confirmed directly against
     tdd.cat's real eyebrow bar (Playwright-measured: archive+site-name
     left, date navigation center, story count + toggle right), which
     reads as a considered "masthead strip" rather than sparse, centered
     leftovers on a wide screen. Scoped to this page only (not
     Layout.astro's shared .masthead-utility) since archive/methodology/
     stats have no meaningful story count to show as their own zone.

     Previously gated behind a 1300px floor to stay clear of the theme
     toggle's old viewport-fixed position - now that the toggle renders
     as a normal in-flow child of this same row (moved out of a fixed
     overlay per deep research), that collision risk no longer exists,
     so the story count shows unconditionally at every width. */
  .story-count {
    font-family: var(--font-body);
  }

  /* Replaces the native input[type=date] calendar picker entirely -
     confirmed via deep research that every real comparable editorial/
     newsletter site examined (tdd.cat, Daring Fireball, Stratechery,
     Friday Front-End) uses a plain prev/next-day link or a flat
     chronological list for date navigation, never a calendar widget;
     one confirmed source explicitly advises against custom calendar UI
     for "known historical dates" and "very distant date ranges", which
     is exactly this site's archive. Jumping to an arbitrary distant date
     is handled entirely by the existing /archive/ list page (linked via
     "All digests" above), not duplicated here. */
  .date-nav a {
    color: var(--accent);
    text-decoration: none;
    font-family: var(--font-body);
  }

  .date-nav a:hover {
    text-decoration: underline;
  }

  .date-nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .date-nav-disabled {
    color: var(--ink-faint);
    font-family: var(--font-body);
  }
</style>
