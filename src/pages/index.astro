---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const allEntries = await getCollection('digest');

// Sort by date descending, then by interest_score descending within the same date.
const sorted = [...allEntries].sort((a, b) => {
  if (a.data.date !== b.data.date) {
    return a.data.date < b.data.date ? 1 : -1;
  }
  return b.data.interest_score - a.data.interest_score;
});

const latestDate = sorted.length > 0 ? sorted[0].data.date : null;

const latestEntries: CollectionEntry<'digest'>[] = latestDate
  ? sorted.filter((entry) => entry.data.date === latestDate)
  : [];

const chartLabels = latestEntries.map((entry) => entry.data.title);
const chartScores = latestEntries.map((entry) => entry.data.interest_score);
const chartDataJson = JSON.stringify({ labels: chartLabels, scores: chartScores });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>daily-dose</title>
  </head>
  <body>
    <header class="masthead">
      <nav class="site-nav"><a href="/stats">Cost &amp; stats &rarr;</a></nav>
      <h1>daily-dose</h1>
      <p class="tagline">A daily AI-curated technical digest — Hacker News and arXiv.</p>
    </header>

    <main>
      {latestDate ? (
        <>
          <h2 class="section-heading">Latest digest — {latestDate}</h2>
          <ul class="story-list">
            {latestEntries.map((entry) => (
              <li class="story-card">
                <a class="story-title" href={entry.data.url} target="_blank" rel="noopener noreferrer">
                  {entry.data.title}
                </a>
                <div class="story-meta">
                  <span class={`badge badge-${entry.data.source}`}>{entry.data.source}</span>
                  <span class="score">score: {entry.data.interest_score.toFixed(1)}</span>
                  {typeof entry.data.points === 'number' && (
                    <span class="points">{entry.data.points} points</span>
                  )}
                </div>
                <p class="why-read">{entry.data.why_read}</p>
              </li>
            ))}
          </ul>

          <h2 class="section-heading">Interest scores</h2>
          <canvas id="score-chart" data-chart={chartDataJson} width="600" height="320"></canvas>
        </>
      ) : (
        <p class="empty-state">
          No digest data yet. Run <code>npm run pipeline</code> to fetch the latest Hacker News
          front page and generate today's digest.
        </p>
      )}
    </main>

    <footer class="site-footer">
      <p>
        Curation is a real AWS Bedrock LLM call by default, with a deterministic placeholder
        heuristic as an explicit fallback (missing credentials, or a per-item response gap) —
        see the project README, or <a href="/stats">cost &amp; stats</a> for real usage data.
      </p>
    </footer>

    <script type="module">
      import Chart from 'chart.js/auto';

      const canvas = document.getElementById('score-chart');
      if (canvas instanceof HTMLCanvasElement) {
        const raw = canvas.dataset.chart;
        const { labels, scores } = raw ? JSON.parse(raw) : { labels: [], scores: [] };

        new Chart(canvas, {
          type: 'bar',
          data: {
            labels,
            datasets: [
              {
                label: 'Interest score',
                data: scores,
                backgroundColor: 'rgba(79, 70, 229, 0.6)',
                borderColor: 'rgba(79, 70, 229, 1)',
                borderWidth: 1,
              },
            ],
          },
          options: {
            scales: {
              y: {
                beginAtZero: true,
                max: 10,
              },
            },
          },
        });
      }
    </script>

    <style>
      :root {
        color-scheme: light dark;
        --bg: #ffffff;
        --fg: #1a1a1a;
        --muted: #6b7280;
        --border: #e5e7eb;
        --accent: #4f46e5;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.5;
      }

      .masthead {
        padding: 2rem 1.5rem 1rem;
        border-bottom: 1px solid var(--border);
      }

      .site-nav a {
        color: var(--accent);
        text-decoration: none;
        font-size: 0.9rem;
      }

      .site-nav a:hover {
        text-decoration: underline;
      }

      .masthead h1 {
        margin: 0.5rem 0 0;
        font-size: 2rem;
      }

      .tagline {
        margin: 0.25rem 0 0;
        color: var(--muted);
      }

      main {
        max-width: 800px;
        margin: 0 auto;
        padding: 1.5rem;
      }

      .section-heading {
        font-size: 1.25rem;
        margin-top: 2rem;
      }

      .story-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .story-card {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
      }

      .story-title {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--accent);
        text-decoration: none;
      }

      .story-title:hover {
        text-decoration: underline;
      }

      .story-meta {
        margin-top: 0.4rem;
        display: flex;
        gap: 0.75rem;
        align-items: center;
        font-size: 0.85rem;
        color: var(--muted);
      }

      .badge {
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.03em;
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        background: #eef2ff;
        color: var(--accent);
      }

      .why-read {
        margin: 0.6rem 0 0;
      }

      .empty-state {
        color: var(--muted);
      }

      .site-footer {
        max-width: 800px;
        margin: 2rem auto 0;
        padding: 1rem 1.5rem 2rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.85rem;
      }
    </style>
  </body>
</html>
