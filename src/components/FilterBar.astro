---
const SOURCES = [
  { value: "hn", label: "HN" },
  { value: "arxiv", label: "arXiv" },
  { value: "github", label: "GitHub" },
  { value: "devto", label: "Dev.to" },
] as const;
const TIERS = [
  { value: "notable", label: "Notable" },
  { value: "recommended", label: "Recommended" },
  { value: "must-read", label: "Must-Read" },
] as const;
---

<div class="filter-bar" id="filter-bar">
  <p class="filter-status" id="filter-status" aria-live="polite"></p>
  <button
    type="button"
    class="filter-toggle"
    id="filter-toggle"
    aria-expanded="false"
    aria-controls="filter-row-main"
  >
    Filters <span class="filter-toggle-chevron" aria-hidden="true">&#9662;</span>
  </button>
  <div class="filter-row-main" id="filter-row-main">
    <div class="filter-row" data-filter-row="source">
      <span class="filter-label">Source:</span>
      <div class="filter-group" data-filter-group="source" role="group" aria-label="Filter by source">
        <button type="button" class="filter-btn" data-filter-value="all" aria-pressed="true">All</button>
        {SOURCES.map((source) => (
          <button type="button" class="filter-btn" data-filter-value={source.value} aria-pressed="false">{source.label}</button>
        ))}
      </div>
    </div>
    <div class="filter-row" data-filter-row="tier">
      <span class="filter-label">Tier:</span>
      <div class="filter-group" data-filter-group="tier" role="group" aria-label="Filter by interest tier">
        <button type="button" class="filter-btn" data-filter-value="all" aria-pressed="true">All</button>
        {TIERS.map((tier) => (
          <button type="button" class="filter-btn" data-filter-value={tier.value} aria-pressed="false">{tier.label}</button>
        ))}
      </div>
    </div>
  </div>
</div>
<p class="empty-state" id="filter-empty-state" role="status" aria-live="polite" hidden>
  No stories match the selected filters.
  <button type="button" id="filter-reset" class="filter-reset-btn">Reset filters</button>
</p>

<style>
  .filter-bar {
    margin-bottom: 1.5rem;
  }

  .filter-status {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  /* One row spanning the full content width, Source pinned left / Tier
     pinned right - confirmed directly against tdd.cat's real Source/
     Signal filter row (Playwright-measured), which fills its content
     column's full width the same way rather than clustering every
     control on one side. Wraps to stacked rows only once genuinely too
     narrow to fit both groups side by side. */
  .filter-row-main {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .filter-btn {
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    color: var(--ink-soft);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border-radius: 3px;
    padding: 0.35rem 0.75rem;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .filter-btn[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .filter-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .filter-reset-btn {
    margin-left: 0.5rem;
    border: none;
    background: none;
    color: var(--accent);
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
  }

  .filter-reset-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Hidden above the mobile breakpoint below - the two filter groups
     stay always-visible on wider viewports, matching the pre-existing
     behavior exactly. */
  .filter-toggle {
    display: none;
  }

  /* Confirmed via a live inspection of tdd.cat's own equivalent filter
     bar (its .filter-mobile-trigger, at the identical 600px breakpoint):
     collapse the pill groups behind a disclosure toggle on narrow
     viewports instead of letting 9 individual pills wrap into several
     ragged rows before any digest content appears. The always-visible
     .filter-status line above this is unaffected, so "Showing X of Y
     stories" still renders immediately either way. */
  @media (max-width: 600px) {
    .filter-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      margin-bottom: 0.75rem;
      border: 1px solid var(--rule);
      background: var(--bg-surface);
      color: var(--ink-soft);
      font-family: var(--font-body);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      border-radius: 3px;
      padding: 0.4rem 0.75rem;
      font-size: 0.75rem;
      cursor: pointer;
    }

    .filter-toggle:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .filter-toggle-chevron {
      display: inline-block;
    }

    .filter-toggle[aria-expanded='true'] .filter-toggle-chevron {
      transform: rotate(180deg);
    }

    .filter-row-main {
      display: none;
    }

    .filter-bar.filters-open .filter-row-main {
      display: flex;
    }
  }
</style>

<script>
  const filterBar = document.getElementById('filter-bar');
  const emptyState = document.getElementById('filter-empty-state');
  const statusLine = document.getElementById('filter-status');
  const filterToggle = document.getElementById('filter-toggle');
  const filterReset = document.getElementById('filter-reset');

  let activeSource = 'all';
  let activeTier = 'all';

  function activeLabel(groupName: string): string | null {
    const group = filterBar?.querySelector<HTMLElement>(`[data-filter-group="${groupName}"]`);
    const pressed = group?.querySelector<HTMLElement>('.filter-btn[aria-pressed="true"]');
    if (!pressed || pressed.dataset.filterValue === 'all') return null;
    return pressed.textContent?.trim() ?? null;
  }

  function applyFilters() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.story-card'));
    let visibleCount = 0;
    for (const card of cards) {
      const matchesSource = activeSource === 'all' || card.dataset.source === activeSource;
      const matchesTier = activeTier === 'all' || card.dataset.interestTier === activeTier;
      const visible = matchesSource && matchesTier;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }
    if (emptyState) emptyState.hidden = visibleCount !== 0;

    if (statusLine) {
      const activeLabels = [activeLabel('source'), activeLabel('tier')].filter(
        (label): label is string => label !== null,
      );
      const scope = activeLabels.length > 0 ? ` — ${activeLabels.join(', ')}` : '';
      statusLine.textContent = `Showing ${visibleCount} of ${cards.length} stories${scope}`;
    }
  }

  filterToggle?.addEventListener('click', () => {
    const isOpen = filterToggle.getAttribute('aria-expanded') === 'true';
    filterToggle.setAttribute('aria-expanded', String(!isOpen));
    filterBar?.classList.toggle('filters-open', !isOpen);
  });

  filterReset?.addEventListener('click', () => {
    activeSource = 'all';
    activeTier = 'all';
    filterBar?.querySelectorAll<HTMLElement>('.filter-btn').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.filterValue === 'all'));
    });
    applyFilters();
  });

  filterBar?.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;
    const button = target.closest<HTMLElement>('.filter-btn');
    if (!button) return;
    const group = button.closest<HTMLElement>('[data-filter-group]');
    const groupName = group?.dataset.filterGroup;
    const value = button.dataset.filterValue;
    if (!groupName || !value) return;

    if (groupName === 'source') activeSource = value;
    if (groupName === 'tier') activeTier = value;

    const buttons = group?.querySelectorAll<HTMLElement>('.filter-btn') ?? [];
    for (const btn of buttons) {
      btn.setAttribute('aria-pressed', String(btn === button));
    }
    applyFilters();
  });

  applyFilters();
</script>
