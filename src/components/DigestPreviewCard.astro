---
import type { DigestDateGroup } from '../lib/digestGrouping.js';

interface Props {
  group: DigestDateGroup;
  showImage?: boolean;
}

const { group, showImage = false } = Astro.props;
const lead = group.entries[0];
---

<li class="preview-card">
  <a class="preview-date" href={`/archive/${group.date}/`}>{group.date}</a>
  {showImage && lead.data.image_url && (
    <img class="preview-image" src={lead.data.image_url} alt="" width="320" height="180" loading="lazy" />
  )}
  <p class="preview-title">{lead.data.title}</p>
  <p class="preview-excerpt">{lead.data.why_read}</p>
  <span class="preview-count">
    {group.entries.length} item{group.entries.length === 1 ? '' : 's'}
  </span>
</li>

<style>
  .preview-card {
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--bg-surface);
  }

  .preview-date {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .preview-date:hover {
    text-decoration: underline;
  }

  .preview-date:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .preview-image {
    display: block;
    width: 100%;
    /* (bug fix) the <img>'s own width/height HTML attributes (kept for
       CLS prevention) map to a fixed-pixel CSS height presentational
       hint - since that counts as an explicit, non-auto height, it wins
       over aspect-ratio's own auto-sizing (aspect-ratio only computes a
       missing dimension when the other is genuinely auto), locking every
       card to the attributes' literal pixel height regardless of this
       image's actual rendered width. height: auto restores aspect-ratio
       as the real source of truth. Confirmed live: without this, a
       320x180-attributed image rendered at a real 1018px card width came
       out 1018x180 (5.6:1) instead of the intended 16:9 box. */
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
  }

  .preview-title {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--ink);
  }

  .preview-excerpt {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .preview-count {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
</style>
