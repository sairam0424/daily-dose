---
import type { CollectionEntry } from 'astro:content';
import { interestTier } from '../lib/interestTier.js';
import { formatReadingBadge } from '../lib/readingTime.js';
import SourceIcon from './SourceIcon.astro';

interface Props {
  entry: CollectionEntry<'digest'>;
  index: number;
}

const { entry, index } = Astro.props;
const tier = interestTier(entry.data.interest_score);
---

<li
  class={`story-card${index === 0 ? ' lead-story' : ''}${entry.data.image_url ? ' has-image' : ''}`}
  data-source={entry.data.source}
  data-interest-tier={tier}
>
  {entry.data.image_url && (
    <img
      class="story-image"
      src={entry.data.image_url}
      alt=""
      loading="lazy"
      width="560"
      height="315"
      referrerpolicy="no-referrer"
      onerror="this.closest('.story-card')?.classList.remove('has-image'); this.remove();"
    />
  )}
  <a class="story-title" href={entry.data.url} target="_blank" rel="noopener noreferrer">
    {entry.data.title}
  </a>
  {entry.data.analysis && <p class="story-analysis">{entry.data.analysis}</p>}
  <div class="story-meta">
    {entry.data.favicon_url && (
      <img
        class="favicon-icon"
        src={entry.data.favicon_url}
        alt=""
        width="16"
        height="16"
        loading="lazy"
        referrerpolicy="no-referrer"
        onerror="this.remove()"
      />
    )}
    <span class={`tier-badge tier-badge-${tier}`}>{tier.replace('-', ' ')}</span>
    <span class={`source-badge source-badge-${entry.data.source}`}><SourceIcon source={entry.data.source} />{entry.data.source}</span>
    <span class="reading-badge">{formatReadingBadge(entry.data)}</span>
    {typeof entry.data.points === 'number' && (
      <span class="points">{entry.data.points} points</span>
    )}
    <span class="why-wrap">
      <button
        type="button"
        class="why-icon"
        aria-expanded="false"
        aria-controls={`why-popover-${entry.id}`}
        aria-label={`Why this made the cut: ${entry.data.why_read}`}
      >
        &#9432;
      </button>
      <span class="why-tooltip" id={`why-popover-${entry.id}`}>{entry.data.why_read}</span>
    </span>
    {typeof entry.data.hn_id === 'number' && (
      <a
        class="discuss-link"
        href={`https://news.ycombinator.com/item?id=${entry.data.hn_id}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Discuss &rarr;
      </a>
    )}
  </div>
</li>

<style>
  .story-card {
    grid-column: span 1;
    padding: 1rem;
    border: 1px solid var(--rule-soft);
    border-radius: 8px;
  }

  .lead-story {
    grid-column: span 1;
    grid-row: span 1;
  }

  .story-card[data-interest-tier='must-read'] {
    border-color: var(--accent);
    border-width: 2px;
  }

  .story-card[data-interest-tier='recommended'] {
    border-color: var(--rule);
  }
  /* 'notable' needs no override - the base border (--rule-soft) is already
     its correct, least-emphasized treatment. */

  @container story-list (min-width: 640px) {
    .story-card {
      grid-column: span 2;
    }

    .story-card.has-image:not(.lead-story) {
      grid-column: span 3;
    }

    .lead-story {
      grid-column: span 4;
      grid-row: span 2;
    }
  }

  .story-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--bg-surface);
    border-radius: 6px;
    margin-bottom: 0.6rem;
  }

  .lead-story .story-image {
    aspect-ratio: 16 / 8;
  }

  /* Dev-editorial headline (default/unscoped values). */
  .story-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }

  .story-title:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  /* (backlog fix) headline and "Discuss" links had no custom
     :focus-visible rule, falling back to the browser's fixed default
     outline color instead of the theme-matched ring every other
     interactive element in this component already gets. */
  .story-title:focus-visible,
  .discuss-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .lead-story .story-title {
    font-size: 1.15rem;
    font-weight: 600;
    display: block;
  }

  .lead-story .story-title::before {
    content: 'Top Pick';
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .story-analysis {
    margin: 0.4rem 0 0;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .lead-story .story-analysis {
    font-size: 0.95rem;
  }

  /* Byline row — Dev-editorial values (Task 3 overrides for Newspaper). */
  .story-meta {
    margin-top: 0.4rem;
    display: flex;
    gap: 0.6rem;
    align-items: center;
    flex-wrap: wrap;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
  }

  .favicon-icon {
    border-radius: 2px;
    vertical-align: middle;
  }

  /* Reuses the exact same tokens the [data-interest-tier] border-color
     rules above already use, so the tier has one source of truth, not
     two independently-maintained color choices. 'notable' stays the
     quietest treatment (--ink-faint text, no border) matching that same
     rule's own comment that it needs the least visual emphasis. */
  .tier-badge {
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--rule-soft);
    color: var(--ink-faint);
  }

  .tier-badge-must-read {
    border-color: var(--accent);
    color: var(--accent);
  }

  .tier-badge-recommended {
    border-color: var(--rule);
    color: var(--ink-soft);
  }

  .source-badge {
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--rule);
    color: var(--ink-soft);
  }

  .reading-badge {
    font-style: italic;
  }

  .why-wrap {
    position: relative;
    display: inline-flex;
  }

  /* Uses --ink-faint: this is a decorative glyph, not reading text. */
  .why-icon {
    border: none;
    background: none;
    color: var(--ink-faint);
    cursor: pointer;
    font-size: 0.85rem;
    line-height: 1;
    padding: 0;
  }

  .why-icon:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Tooltip body text — Dev-editorial values (Task 3 overrides for Newspaper). */
  .why-tooltip {
    /* position: fixed (not absolute) is load-bearing, not a style choice:
       Newspaper's .story-list uses column-count, and this panel's box
       could render as two visually separate painted fragments split
       across a column break despite being out-of-flow - confirmed via
       getClientRects() returning 2 rects for one element, and confirmed
       that neither break-inside: avoid nor contain: layout stopped it
       (both tried and measured, no effect). A fixed-position box's
       containing block is the viewport itself, fully outside any
       ancestor's multicol formatting context, which is what actually
       fixes it. top/left are computed in JS (positionPanel, below) from
       the trigger button's real on-screen position, since a fixed box
       can no longer anchor itself via a relative-positioned ancestor's
       offset the way position: absolute could. */
    position: fixed;
    width: max-content;
    max-width: 260px;
    background: var(--bg-surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 0.5rem 0.6rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
    font-weight: 400;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    z-index: 5;
  }

  .why-icon[aria-expanded='true'] + .why-tooltip {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .why-tooltip {
      transition: opacity 0.15s ease;
    }
  }

  .discuss-link {
    color: var(--accent);
    text-decoration: none;
  }

  .discuss-link:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .story-card {
      transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .story-card:hover {
      transform: translateY(-1px);
      border-color: var(--rule);
    }
  }

  /* Phase 2's bento grid is dev-skin-only. Newspaper keeps its own
     flowing-column look (plain bottom hairline, no card border/radius) -
     restored explicitly here because the base .story-card rule above now
     defines a bordered grid cell instead. */
  :global([data-skin='newspaper']) .story-card {
    border: none;
    border-radius: 0;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule-soft);
    /* (regression fix) break-inside:avoid forces a whole card that
       doesn't fit the remaining space in a column to jump to the next
       column instead of splitting - with real content of very uneven
       card heights (plain-text cards vs. image cards), this compounds
       into badly unbalanced columns: confirmed via Playwright
       getBoundingClientRect on a real archive page, one column ending
       ~460px shorter than the tallest with a big dead gap below it.
       break-inside:auto lets a card flow across a column break like a
       real newspaper article does, and empirically balances the same
       real content to within ~275px across all 3 columns with no card
       actually rendering split in this content - a genuinely more
       authentic newspaper behavior, not just a workaround. */
    break-inside: auto;
  }

  :global([data-skin='newspaper']) .story-card:first-child {
    padding-top: 0;
  }

  :global([data-skin='newspaper']) .story-card[data-interest-tier='must-read'] {
    border-left: 3px solid var(--accent);
    padding-left: 0.75rem;
  }

  :global([data-skin='newspaper']) .story-card[data-interest-tier='recommended'] {
    border-left: 2px solid var(--rule);
    padding-left: 0.75rem;
  }

  :global([data-skin='newspaper']) .story-card[data-interest-tier='notable'] {
    border-left: 2px solid transparent;
    padding-left: 0.75rem;
  }

  /* (Phase 4 fix) Base hover rule adds transform + border-color. Newspaper
     should NOT move on hover — explicitly reset both, rather than relying
     on border-color being merely inert-by-coincidence via the unconditional
     border:none rule's source-order win (fragile to a future reorder). */
  :global([data-skin='newspaper']) .story-card:hover {
    transform: none;
    border-color: transparent;
  }

  /* column-span:all pulls the lead story out of the column flow to span
     full width above the columns — confirmed empirically (Playwright):
     once display:block above is in effect, the lead story renders at
     full list width and the remaining visible cards distribute evenly
     into 3 (or 2/1, responsively) columns. break-inside:auto here is now
     redundant with the general .story-card rule above (both auto), kept
     explicit so this rule still reads correctly on its own regardless
     of the base rule. */
  :global([data-skin='newspaper']) .lead-story {
    column-span: all;
    break-inside: auto;
    margin-bottom: 1rem;
  }

  :global([data-skin='newspaper']) .story-title {
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 600;
  }

  :global([data-skin='newspaper']) .lead-story .story-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }

  /* (review fix, documented deviation) Spec Section 6 describes the
     drop-cap as living on the "byline/excerpt area." This component's
     byline (.story-meta) is a flex row of badge <span> elements, not
     flowing prose text — ::first-letter requires real text content at
     the start of the element's own text, and does not reliably target
     text nested inside a first inline child across browsers. The
     headline is the only element in this component with real flowing
     text, so the drop-cap is applied there instead — a deliberate,
     technically-motivated substitution, not an oversight. */
  :global([data-skin='newspaper']) .lead-story .story-title::first-letter {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 3em;
    float: left;
    line-height: 0.8;
    padding-right: 0.08em;
  }

  /* (review fix) Task 2's base .lead-story .story-title::before rule
     generates non-empty content ('Top Pick'), which per the CSS spec
     becomes part of the element's "first formatted line" — so
     ::first-letter above was binding to the "T" of "Top Pick" instead
     of the real headline. The design intent is for BOTH the drop-cap
     AND the "Top Pick" label to show under Newspaper skin, so instead
     of removing the label (content: none), it is taken out of normal
     flow with position: absolute. Absolutely-positioned generated
     content is removed from the in-flow "first formatted line" that
     ::first-letter considers, so the drop-cap correctly binds to the
     real headline's first letter while the repositioned label still
     renders above it. */
  :global([data-skin='newspaper']) .lead-story .story-title {
    position: relative;
    padding-top: 1.6em;
  }

  :global([data-skin='newspaper']) .lead-story .story-title::before {
    content: 'Top Pick';
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  :global([data-skin='newspaper']) .story-meta {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  :global([data-skin='newspaper']) .why-tooltip {
    font-size: 0.9rem;
    line-height: 1.65;
  }
</style>

<script>
  const wraps = document.querySelectorAll<HTMLElement>('.why-wrap');

  function closeWrap(wrap: HTMLElement) {
    // Deliberately does not reset the panel's inline top/left (set by
    // positionPanel below) - there's no CSS fallback position to revert
    // to, and leaving the last-computed position in place is harmless
    // since the panel is visibility:hidden while closed.
    wrap.querySelector('.why-icon')?.setAttribute('aria-expanded', 'false');
  }

  // .why-tooltip is position: fixed (see its CSS rule for why), so it no
  // longer has a CSS-only anchor to its trigger button - top/left must be
  // computed here from the button's real on-screen position, then
  // clamped so the panel never extends past the viewport edge (which
  // otherwise happens for any card whose icon sits close to that edge).
  // getBoundingClientRect() on the panel works even while
  // visibility:hidden (hidden elements are still laid out), and its
  // width/height are intrinsic (max-content/auto) so they can be read
  // before the panel has a real position yet.
  function positionPanel(wrap: HTMLElement) {
    const button = wrap.querySelector<HTMLElement>('.why-icon');
    const panel = wrap.querySelector<HTMLElement>('.why-tooltip');
    if (!button || !panel) return;
    const buttonRect = button.getBoundingClientRect();
    const panelRect = panel.getBoundingClientRect();
    const left = Math.max(8, Math.min(buttonRect.left, window.innerWidth - panelRect.width - 8));
    const top = Math.max(8, buttonRect.top - panelRect.height - 8);
    panel.style.left = `${left}px`;
    panel.style.top = `${top}px`;
  }

  // A .why-tooltip still occupies its default (potentially overflowing)
  // layout position while visibility:hidden, even before any click -
  // correct every panel once up front so a page with no interaction yet
  // never has horizontal scroll, not just the one a user happens to open.
  wraps.forEach((wrap) => positionPanel(wrap));

  wraps.forEach((wrap) => {
    const button = wrap.querySelector<HTMLButtonElement>('.why-icon');
    button?.addEventListener('click', (event) => {
      event.stopPropagation();
      const isOpen = button.getAttribute('aria-expanded') === 'true';
      wraps.forEach((otherWrap) => {
        if (otherWrap !== wrap) closeWrap(otherWrap);
      });
      button.setAttribute('aria-expanded', String(!isOpen));
      if (!isOpen) positionPanel(wrap);
    });
  });

  document.addEventListener('click', (event) => {
    wraps.forEach((wrap) => {
      if (!wrap.contains(event.target as Node)) closeWrap(wrap);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      wraps.forEach((wrap) => closeWrap(wrap));
    }
  });
</script>
