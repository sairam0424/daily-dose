---
---

<button
  type="button"
  id="scroll-to-top"
  class="scroll-to-top"
  aria-label="Scroll to top"
  hidden
>
  &uarr;
</button>

<style>
  /* right tracks .page-sheet's own real right edge (max-width: 1148px,
     centered) instead of the viewport's right edge - confirmed via deep
     research as a well-established, Baseline-since-2020 technique (real
     precedent: EdCoyle.dev, ag-portfolio). 574px = half of .page-sheet's
     1148px max-width; this only holds because .page-sheet is centered
     via margin:0 auto - re-derive this number if that centering method
     ever changes. Self-collapses to the original flat 1rem for any
     viewport at/below ~1148px+2rem, so no separate mobile override is
     needed - unlike the theme toggle (a one-time-per-session action
     that moved fully in-flow), this button genuinely needs
     position:fixed for scroll-reachability, so only its `right` value
     changes here. */
  .scroll-to-top {
    position: fixed;
    bottom: 1.5rem;
    right: max(1rem, calc(50vw - 574px + 1rem));
    z-index: 10;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--rule);
    background: var(--bg-surface);
    color: var(--ink);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
  }

  .scroll-to-top:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .scroll-to-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 480px) {
    .scroll-to-top {
      bottom: 1rem;
    }
  }
</style>

<script>
  const button = document.getElementById('scroll-to-top');
  const footer = document.querySelector('.site-footer');

  // Gate on real page length first, not just proximity to the footer - a
  // short page's real footer (404, methodology) can already be visible
  // without any scrolling at all, and there's no point offering
  // scroll-to-top there. Only pages genuinely taller than ~4 viewport
  // heights ever attach the observer at all; this is checked once on
  // load, matching this repo's "low-effort, well-established" bar for
  // this kind of affordance rather than re-deriving it on every resize.
  const isLongPage = document.documentElement.scrollHeight > window.innerHeight * 4;

  if (isLongPage && footer && button instanceof HTMLButtonElement) {
    // Real footer, not an artificial sentinel - the button appears once
    // the reader is nearing the end of a genuinely long page's real
    // content, which scales naturally with each page's own length
    // instead of a fixed scroll-distance guess.
    const observer = new IntersectionObserver(([entry]) => {
      button.hidden = !entry.isIntersecting;
    });
    observer.observe(footer);

    button.addEventListener('click', () => {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
    });
  }
</script>
