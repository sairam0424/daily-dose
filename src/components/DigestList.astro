---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'digest'>[];
}

const { entries } = Astro.props;
---

<ul class="story-list">
  {entries.map((entry) => (
    <li class="story-card">
      <a class="story-title" href={entry.data.url} target="_blank" rel="noopener noreferrer">
        {entry.data.title}
      </a>
      <div class="story-meta">
        <span class={`badge badge-${entry.data.source}`}>{entry.data.source}</span>
        <span class="score">score: {entry.data.interest_score.toFixed(1)}</span>
        {typeof entry.data.points === 'number' && (
          <span class="points">{entry.data.points} points</span>
        )}
      </div>
      <p class="why-read">{entry.data.why_read}</p>
    </li>
  ))}
</ul>

<style>
  .story-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .story-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
  }

  .story-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .story-title:hover {
    text-decoration: underline;
  }

  .story-meta {
    margin-top: 0.4rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .badge {
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: #eef2ff;
    color: var(--accent);
  }

  .why-read {
    margin: 0.6rem 0 0;
  }
</style>
