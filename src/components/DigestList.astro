---
import type { CollectionEntry } from 'astro:content';
import { safeJsonLdString } from '../lib/jsonLd.js';
import StoryCard from './StoryCard.astro';

interface Props {
  entries: CollectionEntry<'digest'>[];
}

const { entries } = Astro.props;

// ItemList schema - every field it needs (a real external url + a title)
// already exists on each entry, so this is pure serialization of data
// already in scope, not new content. Deliberately not Article/NewsArticle:
// these are third-party links this site curates, not original reporting,
// which would contradict the site's own correct og:type:website choice.
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: entries.map((entry, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: entry.data.url,
    name: entry.data.title,
  })),
};
---

<script type="application/ld+json" set:html={safeJsonLdString(itemListSchema)} />
<div class="story-list-container">
  <ul class="story-list">
    {entries.map((entry, index) => (
      <StoryCard entry={entry} index={index} />
    ))}
  </ul>
</div>

<style>
  .story-list-container {
    container-type: inline-size;
    container-name: story-list;
  }

  .story-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @container story-list (min-width: 640px) {
    .story-list {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  /* (review fix, critical) .story-list's base rule sets display:grid
     (Task 2.2) — column-count is silently ignored on flex/grid containers
     per the CSS Multi-column spec. This reset is required, not optional;
     confirmed empirically (Playwright) during plan review: omitting it
     renders every card full-width and stacked, with zero columnization. */
  :global([data-skin='newspaper']) .story-list {
    display: block;
    column-count: 1;
    column-gap: 2rem;
    column-rule: 1px solid var(--rule);
  }

  /* Thresholds are calibrated against THIS component's own rendered width,
     not the viewport. 700px sits just under main's ~752px ceiling (3
     columns activate once the container is genuinely wide — viewport
     ≳748px instead of the old ≳1001px, a disclosed improvement: today's
     code renders the identical 752px box at viewport=900 and viewport=1200
     yet shows 2 vs 3 columns purely from an arbitrary viewport cutoff).
     480px approximates the old 640px-viewport threshold's resulting
     container width (640-48=592px), rounded down for breathing room. Do
     not change these numbers without re-deriving from main's
     max-width/padding. */
  @container story-list (min-width: 480px) {
    :global([data-skin='newspaper']) .story-list {
      column-count: 2;
    }
  }

  @container story-list (min-width: 700px) {
    :global([data-skin='newspaper']) .story-list {
      column-count: 3;
    }
  }
</style>

<script>
  // j/k next/previous-item keyboard navigation, plus "t" to jump to top -
  // a mature, well-established convention in reading-list apps (Gmail,
  // Google Reader, Reeder, Feedly, Hacker News power-user extensions).
  // Moves REAL focus to each story's link rather than tracking a separate
  // "selected" index - Enter/Space then open it via the browser's own
  // native link-activation, and .story-title:focus-visible (already
  // defined in StoryCard.astro) supplies the visible highlight for free.
  function getVisibleStoryLinks(): HTMLAnchorElement[] {
    return Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        '.story-list .story-card:not([hidden]) .story-title',
      ),
    );
  }

  function focusRelativeStory(direction: 1 | -1) {
    const links = getVisibleStoryLinks();
    if (links.length === 0) return;

    const currentIndex = links.indexOf(
      document.activeElement as HTMLAnchorElement,
    );
    const nextIndex =
      currentIndex === -1
        ? direction === 1
          ? 0
          : links.length - 1
        : Math.max(0, Math.min(links.length - 1, currentIndex + direction));

    const target = links[nextIndex];
    target.focus();
    target.scrollIntoView({
      block: 'center',
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'auto'
        : 'smooth',
    });
  }

  document.addEventListener('keydown', (event) => {
    // Never hijack real typing - a focused text field/textarea/select or
    // any contenteditable region, or a browser-level modifier chord
    // (Cmd/Ctrl/Alt+key), always wins.
    const active = document.activeElement;
    const isEditable =
      active instanceof HTMLElement &&
      (active.tagName === 'INPUT' ||
        active.tagName === 'TEXTAREA' ||
        active.tagName === 'SELECT' ||
        active.isContentEditable);
    if (isEditable || event.metaKey || event.ctrlKey || event.altKey) return;

    if (event.key === 'j') {
      event.preventDefault();
      focusRelativeStory(1);
    } else if (event.key === 'k') {
      event.preventDefault();
      focusRelativeStory(-1);
    } else if (event.key === 't') {
      event.preventDefault();
      if (active instanceof HTMLElement) active.blur();
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)')
          .matches
          ? 'auto'
          : 'smooth',
      });
    }
  });
</script>

