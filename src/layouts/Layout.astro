---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import SiteMeta from '../components/SiteMeta.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { isFlagEnabled } from '../lib/featureFlags.js';

interface Props {
  title: string;
  description: string;
  path: string;
  includeRssLink?: boolean;
}

const { title, description, path, includeRssLink = true } = Astro.props;

// Dev-editorial skin is a build-time feature flag, off by default - see
// AGENTS.md's scope-discipline section. Off means: Newspaper is the only
// skin, unconditionally, even for a returning visitor whose localStorage
// still has an old "dev" value from before this flag existed (the inline
// bootstrap script below ignores localStorage entirely when this is
// false, rather than merely defaulting an unset value to "newspaper").
const devModeEnabled = isFlagEnabled(import.meta.env.ENABLE_DEV_MODE);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <SiteMeta title={title} description={description} path={path} />
    {includeRssLink && (
      <link rel="alternate" type="application/rss+xml" title="daily-dose" href="/rss.xml" />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500&family=Fraunces:opsz,wght@9..144,400..900&family=Newsreader:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <script is:inline define:vars={{ devModeEnabled }}>
      (function () {
        var skin = devModeEnabled
          ? (localStorage.getItem("skin") || "newspaper")
          : "newspaper";
        document.documentElement.dataset.skin = skin;
        if (skin === "dev") {
          document.documentElement.dataset.theme = "dark";
        } else if (localStorage.getItem("theme") === "dark") {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>
  <body>
    <Analytics />
    <SpeedInsights />
    <ScrollToTop />
    <div class="page-sheet">
      <slot />
    </div>
    <style is:global>
      :root,
      [data-skin='newspaper'] {
        color-scheme: light dark;
        --bg-page: #ece6d6;
        --bg-surface: #f8f4e8;
        --ink: #1f1d18;
        --ink-soft: #4a4536;
        --ink-faint: #857d68;
        --accent: #7a2618;
        --accent-ink: #f8f4e8;
        --rule: rgba(31, 29, 24, 0.15);
        --rule-soft: rgba(31, 29, 24, 0.08);
        --font-display: 'Fraunces', Georgia, serif;
        --font-body: 'Newsreader', Georgia, serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      [data-skin='newspaper'][data-theme='dark'] {
        --bg-page: #16140f;
        --bg-surface: #201d16;
        --ink: #ddd3ba;
        --ink-soft: #a89b7c;
        --ink-faint: #6f6551;
        --accent: #c99356;
        --accent-ink: #16140f;
        --rule: rgba(221, 211, 186, 0.14);
        --rule-soft: rgba(221, 211, 186, 0.07);
      }

      /* Must stay AFTER the block above — see Global Constraints. */
      [data-skin='dev'] {
        --bg-page: #0a0a0c;
        --bg-surface: #14141a;
        --ink: #e8e6f0;
        --ink-soft: #a3a0b8;
        --ink-faint: #6b6880;
        --accent: #f5a623;
        --accent-ink: #1a1206;
        --rule: rgba(232, 230, 240, 0.12);
        --rule-soft: rgba(232, 230, 240, 0.06);
        --font-display: 'Space Grotesk', ui-sans-serif, sans-serif;
        --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: var(--font-body);
        background: var(--bg-page);
        color: var(--ink);
        line-height: 1.5;
      }

      /* Newspaper-only "paper sheet" - confirmed directly against
         tdd.cat's real masthead-through-footer wrapper (Playwright-
         measured: a lighter --bg-surface-toned <article class=
         "newspaper-sheet"> with a real box-shadow, spanning the whole
         page from top to bottom, sitting on a visibly darker --bg-page
         background outside it). Today's page had --bg-page and
         --bg-surface tokens defined but never applied as this kind of
         page-wide surface - every card/heading/rule sat directly on
         --bg-page, so there was no visible "board" to differentiate
         content from background at all, just one flat color. Padding
         absorbs the width difference so main/.masthead/.site-footer's
         own existing max-width:1100px still centers correctly inside -
         nothing about their own CSS needs to change. */
      [data-skin='newspaper'] .page-sheet {
        max-width: 1148px;
        margin: 0 auto;
        padding: 0 24px;
        background: var(--bg-surface);
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.06),
          0 18px 40px -20px rgba(0, 0, 0, 0.35);
      }

      /* Composition model (see the 2026-09-05 masthead deep-research):
         a small, quiet "utility bar" (.masthead-utility — nav + date-jump,
         one row, eyebrow-style typography) sits ABOVE a large "brand
         block" (.masthead-brand — an <hgroup> of the H1 + tagline,
         tightly coupled). The gap BETWEEN those two distinct groups
         (masthead-utility's margin-bottom) is deliberately larger than
         the gap WITHIN the brand block (h1-to-tagline) — "internal ≤
         external" spacing, the inverse of what this masthead had before
         (0px between nav/date-jump, 8px before the brand block, then
         only 4px between h1/tagline — backwards, and indistinguishable
         from unrelated rows just stacked in source order). No rule/
         border is needed at the utility-to-brand boundary — typographic
         contrast alone (tiny uppercase vs. large display serif/sans)
         does that separating work, matching tdd.cat's own masthead. */
      /* max-width/margin/padding deliberately match `main` exactly (same
         1100px, same 1.5rem horizontal padding, same border-box sizing) -
         confirmed directly against tdd.cat's real layout: its own
         masthead-to-body separator <hr> is sized to its content column's
         exact width (measured: both 1036px, identical left/right edges),
         never full-bleed. Without this, the border-bottom below rendered
         edge-to-edge across the whole viewport while every heading/filter/
         card beneath it sat in a much narrower centered column - the
         strongest line on the page gave no visual cue where that column
         actually was, so the body read as "randomly not centered" on wide
         screens even though it WAS centered (just narrower than the rule
         suggested). */
      .masthead {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.75rem 1.5rem 1.5rem;
        border-bottom: 3px double var(--rule);
        text-align: center;
      }

      /* justify-content:space-between (not center) - now that
         PreferenceControls renders as a normal in-flow child of this row
         on every page (moved out of Layout.astro's fixed-position
         overlay per deep research: an editorial theme toggle belongs
         inline in the header, not floating in a viewport corner), every
         page's utility row has ≥2 children (its own nav/date content,
         plus the toggle) and reads better spread to the row's edges than
         clustered in the center. This also obsoletes the old mobile
         padding-right reservation that used to protect against the
         toggle's PREVIOUS fixed-position overlay - normal flex-wrap
         alone now handles narrow viewports correctly, since the toggle
         is a real flex child like any other. */
      .masthead-utility {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.1rem;
        max-width: 1100px;
        margin-inline: auto;
        margin-bottom: 1.75rem;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-faint);
      }

      .site-nav {
        display: flex;
        gap: 1rem;
      }

      .site-nav a {
        color: var(--accent);
        text-decoration: none;
        font-family: var(--font-body);
      }

      .site-nav a:hover {
        text-decoration: underline;
      }

      /* (backlog fix) Nav links had no custom :focus-visible rule, so
         keyboard focus fell back to Chromium's fixed default blue ring —
         theme-inconsistent, and only clears the WCAG 3:1 UI-indicator
         minimum by a thin margin in the two dark skin/theme combos. */
      .site-nav a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .masthead-brand {
        max-width: 1100px;
        margin: 0 auto;
      }

      .masthead-brand h1 {
        margin: 0;
        font-family: var(--font-display);
        font-optical-sizing: auto;
        font-weight: 700;
        font-size: clamp(1.75rem, 4vw, 2.25rem);
        /* Logo.astro's shown-state selectors set the SVG mark's own
           display to `block` (its all-render-then-CSS-toggle pattern
           needs a real display swap, not just visibility) - an SVG's
           own default outer display is inline, so without this the mark
           would force a line break before the wordmark text instead of
           sitting beside it. Flex neutralizes a flex item's own display
           value for layout purposes, so the mark and the text run stay
           on one centered line regardless. */
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
      }

      /* Newspaper's masthead title is deliberately large and heavy -
         confirmed directly against tdd.cat's real, measured masthead
         (Playwright getComputedStyle at a 1920px viewport): its own h1
         renders at 61.6px, font-weight 900. font-optical-sizing:auto
         already makes Fraunces' opsz axis track the larger rendered size
         automatically (it's a genuine letterform-proportion axis, not
         just a scale multiplier - see the Google Fonts wght range below,
         widened to include 900 for this). Ceiling raised from 2.75rem
         (44px) to 4rem (64px) - just past tdd.cat's real measured size,
         not an arbitrary guess. */
      [data-skin='newspaper'] .masthead-brand h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        font-weight: 800;
      }

      .tagline {
        /* Tightly coupled to the h1 immediately above it inside the same
           .masthead-brand hgroup — deliberately smaller than
           .masthead-utility's 1.75rem margin-bottom above, per the
           internal-gap-≤-external-gap rule this masthead now follows. */
        margin: 0.35rem 0 0;
        color: var(--ink-soft);
        font-family: var(--font-body);
      }

      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1.5rem;
      }

      .section-heading {
        font-family: var(--font-display);
        font-optical-sizing: auto;
        font-weight: 600;
        font-size: 1.1rem;
        text-transform: uppercase;
        letter-spacing: 0.02em;
        margin-top: 2rem;
      }

      /* (review fix) Newspaper section headings read fine lower-case-
         adjacent in a serif — spec Section 4 drops the uppercase
         treatment and uses a slightly larger size/looser tracking. */
      [data-skin='newspaper'] .section-heading {
        font-size: 1.2rem;
        text-transform: none;
        letter-spacing: 0.01em;
      }

      /* Deliberately typographic, not illustrated - confirmed via deep
         research: real editorial "nothing here" precedent (ESPN's live
         scoreboard on an off day) uses bare, plain text with zero
         illustration/promotional filler, and NN/g explicitly warns
         against humor in empty/error messaging since it goes stale on
         repeat exposure - both reinforce SOUL.md's no-clickbait,
         no-gimmick mandate over a cute SaaS-style treatment. The one
         concrete, load-bearing finding this DOES act on: NN/g's
         eyetracking research found a small, low-contrast no-results
         message was never even fixated on by real users - so this uses
         the site's own existing display-font/hairline-rule vocabulary
         (already used for section headings and every other content
         boundary on the page) to give the message real presence,
         without a new icon/illustration dependency. */
      .empty-state {
        margin: 1.5rem 0;
        padding-top: 1.5rem;
        border-top: 1px solid var(--rule);
        font-family: var(--font-display);
        font-size: 1.15rem;
        color: var(--ink);
        text-align: center;
      }

      .site-footer {
        max-width: 1100px;
        margin: 2rem auto 0;
        padding: 1.5rem 1.5rem 2rem;
        border-top: 3px double var(--rule);
        font-family: var(--font-body);
        text-align: center;
      }

      .site-footer-tagline {
        margin: 0 0 1rem;
        color: var(--ink-soft);
        font-size: 0.85rem;
      }

      .site-footer-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin: 0 0 0.75rem;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-faint);
      }

      .site-footer-links a {
        color: var(--accent);
        text-decoration: none;
      }

      .site-footer-links a:hover {
        text-decoration: underline;
      }

      .site-footer-links a:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .site-footer-copyright {
        margin: 0;
        color: var(--ink-faint);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
    </style>
  </body>
</html>
